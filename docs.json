{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ER:LC Россия API",
  "colors": {
    "primary": "#02B1DA",
    "light": "#02B1DA",
    "dark": "#02B1DA"
  },
  "icons": {
    "library": "fontawesome"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "navigation": {
    "languages": [
      {
        "$ref": "./ru.json"
      },
      {
        "$ref": "./en.json"
      },
      {
        "$ref": "./uk.json"
      },
      {
        "$ref": "./es.json"
      },
      {
        "$ref": "./it.json"
      }
    ]
  },
  "logo": {
    "light": "/icons/Banner-ERLC-Russia-Docs-System.svg",
    "dark": "/icons/Banner-ERLC-Russia-Docs-System.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "background": {
    "color": {
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "redirects": [
    {
      "source": "/ru/reference/v3/overview",
      "destination": "/ru/reference/v3/erlc/get-erlc-server"
    },
    {
      "source": "/ru/reference/v3/cdn/overview",
      "destination": "/ru/other/cdn-integration"
    },
    {
      "source": "/en/reference/v3/overview",
      "destination": "/en/reference/v3/erlc/get-erlc-server"
    },
    {
      "source": "/en/reference/v3/cdn/overview",
      "destination": "/en/other/cdn-integration"
    },
    {
      "source": "/uk/reference/v3/overview",
      "destination": "/uk/reference/v3/erlc/get-erlc-server"
    },
    {
      "source": "/uk/reference/v3/cdn/overview",
      "destination": "/uk/other/cdn-integration"
    },
    {
      "source": "/es/reference/v3/overview",
      "destination": "/es/reference/v3/erlc/get-erlc-server"
    },
    {
      "source": "/es/reference/v3/cdn/overview",
      "destination": "/es/other/cdn-integration"
    },
    {
      "source": "/it/reference/v3/overview",
      "destination": "/it/reference/v3/erlc/get-erlc-server"
    },
    {
      "source": "/it/reference/v3/cdn/overview",
      "destination": "/it/other/cdn-integration"
    },
    {
      "source": "/ru/index",
      "destination": "/ru/introduction"
    },
    {
      "source": "/en/index",
      "destination": "/en/introduction"
    },
    {
      "source": "/uk/index",
      "destination": "/uk/introduction"
    },
    {
      "source": "/es/index",
      "destination": "/es/introduction"
    },
    {
      "source": "/it/index",
      "destination": "/it/introduction"
    }
  ]
}
